# Copy the values you need into .env.production (used by `npm run build:cpanel`).
# These IDs are public (they end up in the page source); never put passwords here.

# Google Tag Manager container ID. Empty = no GTM / Analytics is loaded at all.
VITE_GTM_ID=

# Google Search Console "HTML tag" verification: only the content="..." value.
VITE_GSC_VERIFICATION=

# Where the quote form posts leads. Leave empty in production (same-origin /backend/api/lead.php).
# For local development put it in .env.development.local, e.g.:
# VITE_LEAD_ENDPOINT=http://localhost/backend/api/lead.php
VITE_LEAD_ENDPOINT=
